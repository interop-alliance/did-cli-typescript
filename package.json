{
  "name": "@interop/did-cli",
  "version": "0.2.0",
  "description": "DID CLI tool for DIDs, Verifiable Credentials, key pairs, and zcaps",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "di": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "fix": "eslint --fix src && npm run format",
    "format": "prettier --write src",
    "lint": "eslint src",
    "start": "node --enable-source-maps dist/index.js",
    "test": "npm run lint && npm run format && npm run test:node",
    "test:node": "node --test --import tsx --enable-source-maps 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@digitalcredentials/bnid": "^5.0.0",
    "@digitalcredentials/issuer-registry-client": "^4.0.0",
    "@interop/data-integrity-core": "^6.1.2",
    "@interop/data-integrity-proof": "^3.2.1",
    "@interop/did-method-key": "^7.1.1",
    "@interop/ed25519-signature": "^7.0.1",
    "@interop/ed25519-verification-key": "^7.0.1",
    "@interop/ezcap": "^7.1.1",
    "@interop/security-document-loader": "^9.2.1",
    "@interop/vc": "^11.0.1",
    "@interop/verifier-core": "^3.1.0",
    "@interop/zcap": "^11.0.1",
    "@scure/base": "^2.2.0",
    "commander": "^15.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2"
  }
}
